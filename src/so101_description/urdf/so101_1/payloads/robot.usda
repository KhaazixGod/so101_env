#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "so101"
    doc = """Generated from Composed Stage of root layer /tmp/tmpz91ncmwg/so101.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_so101_cxbug9g2/usdex_so101/so101.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_so101_cxbug9g2/temp_so101/so101.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "so101" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </so101/Physics/world_to_base>,
        </so101/Physics/joint_1>,
        </so101/Physics/joint_2>,
        </so101/Physics/joint_3>,
        </so101/Physics/joint_4>,
        </so101/Physics/joint_5>,
        </so101/Physics/gripper_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </so101/Geometry/world/base_link>,
        </so101/Geometry/world/base_link/link_2>,
        </so101/Geometry/world/base_link/link_2/link_3>,
        </so101/Geometry/world/base_link/link_2/link_3/link_4>,
        </so101/Geometry/world/base_link/link_2/link_3/link_4/link_5>,
        </so101/Geometry/world/base_link/link_2/link_3/link_4/link_5/wrist_roll_follower_so101_v1>,
        </so101/Geometry/world/base_link/link_2/link_3/link_4/link_5/wrist_roll_follower_so101_v1/moving_jaw_so101_v1>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "world"
        {
            over "base_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "link_2" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "link_3" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "link_4" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "link_5" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "wrist_roll_follower_so101_v1" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "moving_jaw_so101_v1" (
                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                    )
                                    {
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "world_to_base" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_3" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_4" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_5" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

